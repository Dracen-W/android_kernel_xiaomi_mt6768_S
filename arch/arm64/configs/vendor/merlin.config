CONFIG_ARCH_MTK_PROJECT="merlin"
CONFIG_CUSTOM_KERNEL_IMGSENSOR="s5kgm1sp_mipi_raw s5kgm1sp_sunny_mipi_raw ov13b10_mipi_raw ov13b10_sunny_mipi_raw s5k4h7yx_mipi_raw s5k4h7yx_sunny_mipi_raw ov2180_mipi_raw ov2180_sunny_mipi_raw gc02m1_macro_mipi_raw gc02m1_macro_sunny_mipi_raw ov2680_sunny_mipi_raw"
CONFIG_CUSTOM_KERNEL_LCM="nt36672A_fhdp_dsi_vdo_tianma ft8719_fhdp_dsi_vdo_xinli nt36672A_fhdp_dsi_vdo_tianma_G6 nt36672D_fhdp_dsi_vdo_tianma"
